# Copy to backend/.env. Every value is optional: the demo runs with no configuration at all.

# SQLite by default. For PostgreSQL, install a driver (pip install "psycopg[binary]") and use e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stranded
DATABASE_URL=sqlite:///./stranded.db

# Signs session tokens. The server refuses to start with the default when DEMO_MODE=false.
JWT_SECRET=dev-only-secret-change-me-before-any-real-deployment
JWT_TTL_MINUTES=720

# true exposes the scenario reset, simulated passenger responses and the quick-login list.
# Must be false anywhere outside a demonstration.
DEMO_MODE=true

# auto = OR-Tools CP-SAT when installed, otherwise greedy. Or force cp_sat / greedy.
ALLOCATION_SOLVER=auto

# Origins allowed to call the API from a browser (only matters for the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
